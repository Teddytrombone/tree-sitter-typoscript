====
Reference assignment
====

foo =< bar

---

(typoscript
  (reference_line
    (identifier)
    (reference_identifier)))

====
Reference assignment with whitespace
====

foo = < bar

---

(typoscript
  (reference_line
    (identifier)
    (reference_identifier)))

====
Copy
====

foo < bar

---

(typoscript
  (copy_line
    (identifier)
    (copy_identifier)))

====
Copy with comment
====

foo < bar # Something

---

(typoscript
  (copy_line
    (identifier)
    (copy_identifier)
    (single_line_comment)))

====
Copy nested
====

myIdentifier {
   20 < myIdentifier.10
}

---

(typoscript
  (configuration_block
    (identifier)
    (block
      (block_punctuation)
      (block_inner_content
        (copy_line
          (identifier)
          (copy_identifier)))
      (block_punctuation))))

====
Copy nested relative
====

myIdentifier {
   20 < .10
}

---

(typoscript
  (configuration_block
    (identifier)
    (block
      (block_punctuation)
      (block_inner_content
        (copy_line
          (identifier)
          (copy_identifier)))
      (block_punctuation))))

====
Deletion
====

foo >

---

(typoscript
  (deletion_line
    (identifier)))

====
Deletion with comment
====

foo > # Something

---

(typoscript
  (deletion_line
    (identifier)
    (single_line_comment)))

====
Modification
====

foo:=addToList(123)

---

(typoscript
  (modification_line
    (identifier)
    (modifier_predefined)
    (modifier_parameters
      (modifier_parameter))))

====
Modification with comment
====

foo := addToList(123) # Something

---

(typoscript
  (modification_line
    (identifier)
    (modifier_predefined)
    (modifier_parameters
      (modifier_parameter))
    (single_line_comment)))

====
Modification with brace and user defined function
====

foo := addToListTest(x-inf())

---

(typoscript
  (modification_line
    (identifier)
    (modifier_function)
    (modifier_parameters
      (modifier_parameter))))
