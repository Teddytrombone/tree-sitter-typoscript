# From: test/corpus/assignment.txtt

# Assignment
foo = bar

page = PAGE

# Assignment with html code
foo = <ul>

# Assignment XML prologue sitemap
foo = <?xml version="1.0" encoding="UTF-8"?><urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">|</urlset>

# Nested assignment
foo.bar = baz

# Double nested assignment
foo.bar.baz = baz

# Assignment with comment (comment has to be treated as part of the value)
foo = bar # comment

# Assignment with parenthese like multiline value but isn't
foo = (

# Assignment with constant
foo = {$foo.bar}
foo = {$foo.bar ?? $foo.baz}

# Assignment with multiline value
foo (
bar
)

# Assignment with multiline value and constant
foo (
bar {$test} baz
foobar
)

# Assignment with multiline value and parentheses inline
foo (
bar (baz
foobar)
test
)

# Assign with data fields
20.wrap = |{register:newLine}

# From: test/corpus/configuration.txtt

# Reference assignment
foo =< bar

# Reference assignment with whitespace
foo = < bar

# Copy
foo < bar

# Copy with comment
foo < bar # Something

# Copy nested
myIdentifier {
   20 < myIdentifier.10
}

# Copy nested relative
myIdentifier {
   20 < .10
}

# Deletion
foo >

# Deletion with comment
foo > # Something

# Modification
foo:=addToList(123)

# Modification with comment
foo := addToList(123) # Something

# Modification with brace and user defined function
foo := addToListTest(x-inf())

# From: test/corpus/imports.txtt

# Include old syntax
<INCLUDE_TYPOSCRIPT: source="FILE:EXT:foo/Configuration/TypoScript/setup.typoscript">

# Include old syntax, no space
<INCLUDE_TYPOSCRIPT:source="FILE:EXT:foo/Configuration/TypoScript/setup.typoscript">

# Include old syntax with extensions
<INCLUDE_TYPOSCRIPT: source="FILE:EXT:foo/Configuration/TypoScript/setup.typoscript" extensions="typoscript">

# Include old syntax with condition
<INCLUDE_TYPOSCRIPT: source="FILE:EXT:foo/Configuration/TypoScript/setup.typoscript" condition="YourVendor\YourPackage\YourCondition">

# Import new syntax single quotes
@import 'EXT:foo/Configuration/TypoScript/setup.typoscript'

# Import new syntax double quotes
@import "EXT:foo/Configuration/TypoScript/setup.typoscript"

# Import new syntax wildcard
@import "EXT:foo/Configuration/TypoScript/*.typoscript"
test = */
