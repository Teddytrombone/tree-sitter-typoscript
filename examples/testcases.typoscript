# From: test/corpus/conditions/typo3.txtt

# Application context checks
[applicationContext == "Development"]
[applicationContext == "Production"]
[applicationContext matches "/^Production/"]
[applicationContext starts with "Production"]

# Page context checks
[page.uid == 2]
[page.uid in [17, 24]]
[page.uid not in [17, 24]]
[page.uid in 10..20]
[page.backend_layout == 5]
[page.backend_layout == "example_layout"]
[page.backend_layout in ['2', '3', '4', '5']]
[page.title == "foo"]
[page.title matches "/^foo/"]

# Tree context checks
[tree.level == 0]
[tree.level in [0, 1, 2]]
[tree.pagelayout === "2"]
[tree.pagelayout == "pagets__Home"]
[tree.pagelayout in ['2', '3', '4', '5']]
[tree.rootLine[0]["uid"] == 1]
[2 in tree.rootLineIds]
[2 in tree.rootLineParentIds]

# Backend user checks
[backend.user.isAdmin]
[backend.user.isLoggedIn]
[backend.user.userId == 5]
[2 in backend.user.userGroupIds]
[like(","~backend.user.userGroupList~", ", "*,1,*")]

# Frontend user checks
[frontend.user.isLoggedIn]
[frontend.user.userId == 5]
[4 in frontend.user.userGroupIds]
[like(","~frontend.user.userGroupList~", ", "*,1,*")]

# Workspace checks
[workspace.workspaceId == 0]
[workspace.isLive]
[workspace.isOffline]

# TYPO3 version checks
[typo3.version == "13.4.0"]
[typo3.version == "13.4"]
[typo3.branch == "13.4"]
[typo3.devIpMask == "172.18.0.6"]
[like(typo3.branch, "/1[01]\..*/")]

# Date functions
[date("j") == 7]
[date("w") == 7]
[date("z") == 7]
[date("G") == 7]

# String matching
[like("fooBarBaz", "*Bar*")]
[like("fooBarBaz", "f?oBa?Baz")]
[like("fooBarBaz", "/f[o]{2,2}[aBrz]+/")]

# Array traversal
[request && traverse(request.getQueryParams(), 'tx_news_pi1/news') > 0]
[traverse(page ?? [], "pid") == 65]
[traverse(page, "pid") == 65]

# Environment variables
[getenv("VIRTUAL_HOST") == "www.example.org"]
[getenv("TYPO3_CONTEXT") == "Production"]

# Feature flags
[feature("security.frontend.enforceContentSecurityPolicy") === true]

# IP matching
[ip("172.18.*")]
[ip("devIP")]

# Request parameters
[request && request.getQueryParams()['tx_news_pi1']['news'] > 0]
[request && traverse(request.getParsedBody(), 'foo') == 1]
[request && request.getHeaders()['Accept'] == 'json']
[request && request.getCookieParams()['foo'] == 1]
[request && request.getNormalizedParams().isHttps()]
[request && request.getPageArguments()['foo_id'] > 0]

# Session access
[session("foo|bar") == "1234567"]

# Site information
[site("identifier") == "my_site"]
[site("base").getHost() == "www.example.org"]
[site("base").getPath() == "/"]
[site("rootPageId") == 1]
[traverse(site("configuration"), 'myCustomProperty') == true]

# Site language
[siteLanguage("languageId") == 1]
[siteLanguage("locale").getName() == "en-GB"]
[siteLanguage("locale").getCountryCode() == "US"]
[siteLanguage("title") == "Italy"]
[siteLanguage("typo3Language") == "default"]
[siteLanguage("hreflang") == "en"]
[siteLanguage("fallbackType") == "strict"]
[siteLanguage("fallbackLanguageIds") == "1,0"]
[like(","~siteLanguage("fallbackLanguageIds")~", ", "*,1,*")]

# Locale information
[locale().getName() == "en-US"]
[locale().getCountryCode() == "US"]
[locale().isRightToLeftLanguage()]

# TYPO3 version compatibility
[compatVersion("13.4")]
[compatVersion("13.4.0")]

# Constants in conditions
[{$tx_my_extension.settings.feature1Enabled} == 1]
[{$tx_my_extension.settings.feature1Enabled} === "1"]
[{$tx_my_extension.settings.feature1Enabled} == "active"]
["{$tx_my_extension.settings.feature1Enabled}" == "active"]
["{$tx_my_extension.settings.feature1Enabled}" === "active"]

# Complex conditions with page traversal
[traverse(page, 'uid') in [1, 2, 3] && page.doktype == 1]
[traverse(page, 'title') matches "/^Home/"]
[traverse(page, 'backend_layout') in ['2', '3']]
[traverse(page, 'title') == "Home"]

# Complex array operations
[2 in backend.user.userGroupIds && 5 in frontend.user.userGroupIds]
[like(","~backend.user.userGroupList~", ", "*,1,*")]
[like(","~frontend.user.userGroupList~", ", "*,1,*")]

# Multi-level checks with site and user
[site("identifier") == "corporate_site" && backend.user.isLoggedIn]
[site("base").getHost() == "example.org" && workspace.isLive]

# Date-based conditions
[date("Y") == "2024"]
[date("m") >= 6 && date("m") <= 8]
[date("d") == 25]

# Advanced traversal with fallbacks
[traverse(page, 'teaser') ?? traverse(page, 'subtitle') ?? "Default"]
[traverse(page, 'image') && traverse(page, 'image').uid > 0]

# Combined TYPO3 and Symfony EL patterns
[page.title ~ " (" ~ site("title") ~ ")"]
[user.name ~ " (" ~ backend.user.firstName ~ " " ~ backend.user.lastName ~ ")"]

# Conditional rendering based on multiple factors
[backend.user.isAdmin && (page.doktype == 1 || page.doktype == 2)]
[frontend.user.isLoggedIn && workspace.isLive && page.hidden == 0]

# Complex nested conditions
[(traverse(page, 'categories') && traverse(page, 'categories')|length > 0) && page.nav_hide == 0]
[(backend.user.isAdmin || frontend.user.isLoggedIn) && applicationContext != "Development"]

# From: test/corpus/conditions/operators.txtt

# Basic Arithmetic
[1 + 2]

# Power Operator
[2 ** 3]

# Bitwise AND
[5 & 3]

# Bitwise NOT
[~5]

# Comparison
[a == b]

# String Concatenation
["hello" ~ "world"]

# Array In
[x in [1, 2, 3]]

# Range
[1..5]

# Null Coalescing
[foo ?? bar]

# Null Safe Property
[user?.name]

# Ternary
[a ? b : c]

# Logical AND
[a and b]

# Parentheses
[(1 + 2) * 3]

# String Contains
["hello" contains "ell"]

# String Starts With
["hello" starts with "he"]

# String Ends With
["hello" ends with "lo"]

# String Matches
["hello" matches "/h.*o/"]

# Array Not In
["x" not in [1, 2, 3]]

# Bitwise Left Shift
[1 << 2]

# Bitwise Right Shift
[8 >> 2]

# Bitwise XOR
[5 ^ 3]

# Bitwise OR
[5 | 3]

# Complex Ternary
[a ? (b ? c : d) : e]

# From: test/corpus/conditions/comments.txtt

# Block Comment
[/* this is a comment */]

# Comment After Expression
[true /* comment after expression */]

# Comment Before Expression
[/* comment */ true]

# Comment Between Expressions
[true /* comment */ false]

# Comments anywhere
[user.name.test /* comment after expression */ .value]

# From: test/corpus/conditions/property_access.txtt

# Property Access
[user.name]

# Method Call
[user.getName()]

# Array Access
[items[0]]

# Chained Access
[data.items[0]]

# Nested Property Access
[user.address.street]

# Method on Property
[user.address.getStreet()]

# Predefined chained method calls
[request.getRequestBody().address.getStreet()]

# From: test/corpus/conditions/functions.txtt

# constant Function
[constant("APP_DEBUG")]

# Enum Function
[enum("App\\SomeNamespace\\Foo::Bar")]

# Min Function
[min(1, 2, 3)]

# Max Function
[max(1, 2, 3)]

# Custom Function
[custom_func()]

# From: test/corpus/conditions/base.txtt

# Application Context
[applicationContext == "Development"]
[applicationContext == "Production/Staging"]

# Language Selection
[siteLanguage("locale") == "en_US.UTF-8"]
[siteLanguage("title") == "English"]

# With Get Parameter: e.g., &print=1
[request.getQueryParams() ['print'] > 0]
[traverse(request.getQueryParams(), 'tx_news_pi1/news') > 0]

# Single Page WITHOUT Subpages
[traverse(page, "uid") == 17]
[traverse(page, "uid") in [17,24]]
[getTSFE().id == 17]
[getTSFE().id in [17,24]]

# Page ID AND its Subpages
[17 in tree.rootLineIds || 24 in tree.rootLineIds]

# ONLY Subpages of the specified Page ID, not the selected page itself
[17 in tree.rootLineParentIds || 24 in tree.rootLineParentIds]

# Domain
[request.getNormalizedParams().getHttpHost() == 'www.example.org']
[like(request.getNormalizedParams().getHttpHost(), '*.test')]

# Protocol
[request.getNormalizedParams().isHttps() == false]

# Query Page Properties (FE only)
[traverse(page, "backend_layout") == 'pagets__2_columns_33_66']

# Query Page Properties (FE and BE)
[tree.pagelayout == 1]
[tree.pagelayout == "pagets__1Column"]

# User Groups
[usergroup("1,2")]

# Frontend User
// Logged in as any frontend user:
[loginUser('*')]
[frontend.user.isLoggedIn == 1]
 
# Logged in as a specific frontend user:
[frontend.user.userId == 2]
 
# Logged in as one of the listed frontend users:
[loginUser('1,2')]
[frontend.user.userId in [1,2]]
 
# Currently not logged in on the frontend:
[loginUser('*') == false]

# Frontend User Logged in to Backend?
[getTSFE().isBackendUserLoggedIn()]

[backend.user.isLoggedIn]
[backend.user.isAdmin]
[backend.user.userId == 2]

# Read Constant greater than 10
[{$constant} > 10]

# Read Values from Site Configuration
[site("identifier") == "mysite"]
[site("base") == "http://local.test/"]

# Conditions [global] and [else]
[Condition]
page.10.value = Internet Explorer
[ELSE]
page.10.value = No Internet Explorer!
[END]
 
# negate condition
[Condition]
[else]
page.10.value = foobar
[end]

# Conditions && and ||
// AND
[Condition1 && Condition2]
 
# OR
[Condition1 || Condition2] 
 
# OR mixed with AND
[frontend.user.isLoggedIn == 1 || getTSFE().id == 75 && siteLanguage("title") == "English"]
test = 1

# Conditions negate
[!Condition1]

[Condition1 && !Condition2]

