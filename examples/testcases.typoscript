# Complex Expressions
[(a + b) * c]

# Complex Logical Expression
[user.age >= 18 and user.isActive]

# Chained Array and Property Access
[items[0].name]

# Complex Ternary
[condition ? trueValue : falseValue]

# Complex Unary with Logical
[not (a or b) and c]

# Function with Property Argument
[func(arg1, arg2.property)]

# Method Call Chain
[object.method().property]

# Array Access with Method Call
[array[index].method(arg)]

# Complex Nested Access
[data["key"].nested.property]

# From: test/corpus/comments.txtt

# Single line comment
# comment
// comment
/* comment */

# Multi line comment
/* comment
over
multiple
lines
*/

# Comments with different operators
foo < bar // This is a comment
foo < bar /* This is a valid comment, too */

foo > # Another valid comment

foo := addToList(1) # Yes, a comment

[foo == bar] # Many comment. Much wow.

# Comments inside multiline value
foo (
  # This is NOT a comment but part of the value assignment!
  bar = barValue
) # This is a comment

foo (
  /*
    * This is NOT a comment but part of the value assignment!
    */
  bar = barValue
) /* This is a comment */

# Comments in assignments
foo = bar // This is NOT a comment but part of the value assignment!

foo = bar /* This is NOT a comment but part of the value assignment! */

