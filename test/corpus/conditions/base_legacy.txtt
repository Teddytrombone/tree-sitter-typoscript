====
Conditions AND/OR pre TYPO3 9
====
 
// AND
[Condition1] && [Condition2]
[Condition1] AND [Condition2]

// OR
[Condition1][Condition2]
[Condition1] || [Condition2]
[Condition1] OR [Condition2]

// OR mixed with AND
[browser = firefox] || [browser = msie] && [version => 8]

---

(typoscript
  (single_line_comment)
  (condition_block
    (condition
      (symfony_expression
        (symfony_variable)))
    (condition_bool_legacy)
    (condition
      (symfony_expression
        (symfony_variable))))
  (condition_block
    (condition
      (symfony_expression
        (symfony_variable)))
    (condition_bool_legacy)
    (condition
      (symfony_expression
        (symfony_variable)))
    (single_line_comment))
  (condition_block
    (condition
      (symfony_expression
        (symfony_variable)))
    (condition
      (symfony_expression
        (symfony_variable))))
  (condition_block
    (condition
      (symfony_expression
        (symfony_variable)))
    (condition_bool_legacy)
    (condition
      (symfony_expression
        (symfony_variable))))
  (condition_block
    (condition
      (symfony_expression
        (symfony_variable)))
    (condition_bool_legacy)
    (condition
      (symfony_expression
        (symfony_variable)))
    (single_line_comment))
  (condition_block
    (condition
      (symfony_expression
        (symfony_variable))
      (ERROR)
      (symfony_expression
        (symfony_variable)))
    (condition_bool_legacy)
    (condition
      (symfony_expression
        (symfony_variable))
      (ERROR)
      (symfony_expression
        (symfony_variable)))
    (condition_bool_legacy)
    (condition
      (symfony_expression
        (symfony_binary_expression
          (symfony_expression
            (symfony_variable))
          (ERROR)
          (symfony_condition_operator)
          (symfony_expression
            (symfony_literal
              (symfony_number))))))))
